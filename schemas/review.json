{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchOS Review",
  "type": "object",
  "required": [
    "review_id",
    "proposal_id",
    "session_id",
    "checks",
    "result",
    "created_at"
  ],
  "properties": {
    "review_id": {"type": "string", "pattern": "^REV-[0-9]{3}$"},
    "proposal_id": {"type": "string", "pattern": "^PRP-[0-9]{3}$"},
    "session_id": {"type": "string", "pattern": "^SES-[a-z0-9][a-z0-9-]*$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string"},
          "result": {"type": "string", "enum": ["pass", "fail", "skip"]},
          "detail": {"type": "string"}
        }
      }
    },
    "result": {"type": "string", "enum": ["pass", "fail", "partial"]},
    "summary": {"type": "string"},
    "created_at": {"type": "string"},
    "environment": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
