{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchOS Claim",
  "type": "object",
  "required": ["claim_id", "statement", "evidence_ids", "status", "scope"],
  "properties": {
    "claim_id": {"type": "string"},
    "statement": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "counterclaim_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["candidate", "supported", "disputed", "rejected"]},
    "scope": {"type": "string"},
    "limitations": {"type": "string"},
    "hypothesis_ids": {"type": "array", "items": {"type": "string"}}
  }
}
