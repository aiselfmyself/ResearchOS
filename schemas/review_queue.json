{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchOS Review Queue Item",
  "type": "object",
  "required": [
    "queue_id",
    "proposal_id",
    "required_checks",
    "status",
    "created_at",
    "created_by_session"
  ],
  "properties": {
    "queue_id": {"type": "string", "pattern": "^RQ-[0-9]{3}$"},
    "proposal_id": {"type": "string", "pattern": "^PRP-[0-9]{3}$"},
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["open", "claimed", "completed", "cancelled"]},
    "created_at": {"type": "string"},
    "created_by_session": {"type": "string"},
    "priority": {"type": "string", "enum": ["high", "normal", "low"]},
    "claimed_by_session": {"type": "string"},
    "claimed_at": {"type": "string"},
    "review_id": {"type": "string"},
    "notes": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
