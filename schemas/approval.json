{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchOS Approval",
  "type": "object",
  "required": [
    "approval_id",
    "proposal_id",
    "session_id",
    "review_ids",
    "decision",
    "review_line_sha256",
    "created_at"
  ],
  "properties": {
    "approval_id": {"type": "string", "pattern": "^APR-[0-9]{3}$"},
    "proposal_id": {"type": "string", "pattern": "^PRP-[0-9]{3}$"},
    "session_id": {"type": "string", "pattern": "^SES-[a-z0-9][a-z0-9-]*$"},
    "review_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision": {"type": "string", "enum": ["approved", "rejected"]},
    "rationale": {"type": "string"},
    "review_line_sha256": {
      "type": "object",
      "description": "PRP-002 rev3 (C3/A2): MANDATORY. Binds the approval to the reviewed content: one entry per cited review_id holding that review line's canonical sha256. Without it an approver can be handed a different review after the fact. Approvals recorded before PRP-002 rev3 are grandfathered in policy/roles.json (enforcement.approval_review_binding) and only warn.",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "review_sha256": {
      "type": "string",
      "description": "Alternative single-hash binding (for single-review approvals)",
      "pattern": "^[0-9a-f]{64}$"
    },
    "conditions": {
      "type": "array",
      "items": {"type": "object"}
    },
    "evidence": {"type": "array"},
    "final_gate": {"type": "string"},
    "scope": {"type": "string"},
    "created_at": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
