{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "Open Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "question", "status", "motif_ids", "material_ids", "previous_question_ids", "origin", "created_at"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["open", "paused", "archived"]},
    "motif_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "material_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "previous_question_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {"type": "string", "enum": ["human_seed", "material", "session", "migration"]},
        "detail": {"type": "string"}
      }
    },
    "created_at": {"type": "string", "minLength": 4},
    "notes": {"type": "string"}
  }
}
