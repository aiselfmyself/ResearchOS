{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motif.schema.json",
  "title": "Motif",
  "type": "object",
  "additionalProperties": false,
  "required": ["motif_id", "label", "description", "question_ids", "material_ids"],
  "properties": {
    "motif_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "question_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "material_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"type": "string", "enum": ["active", "paused", "archived"], "default": "active"}
  }
}
